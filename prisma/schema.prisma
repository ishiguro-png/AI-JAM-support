generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 契約先（会社単位）。アカウント数・サポートプランはContractLineから都度集計する
model Contract {
  id           String    @id @default(cuid())
  companyName  String
  contactName  String?
  contactEmail String?
  phone        String?
  status       String    @default("active") // active | cancelled | paused
  notes        String?
  importedAt   DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  contractLines ContractLine[]
  supportLogs   SupportLog[]

  @@index([companyName])
}

// 契約明細（torimatoの1行 = 月契約 or 年契約などの単位）
// 会社単位のアカウント数は「現在日が開始日以上・終了日以下」の行のquantityを合算して算出する
model ContractLine {
  id           String   @id @default(cuid())
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractType String // 例: "月契約" | "年契約"（torimatoのCSV表記をそのまま保持）
  quantity     Int
  startDate    DateTime // 日付のみを保持（時刻は00:00 UTCに正規化）
  endDate      DateTime // 同上
  externalId   String?  @unique // torimato側の行の一意キー（あれば再インポート時の重複防止に使う）
  importedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([contractId])
  @@index([startDate, endDate])
}

// 対応履歴（メール送信ログ含む、誰が・いつ・何を対応したか）
model SupportLog {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type        String // "email" | "call" | "visit" | "note" | "other"
  staffName   String
  subject     String?
  content     String
  emailTo     String?
  emailStatus String? // "sent" | "failed"（type=emailの場合のみ）
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([contractId])
  @@index([occurredAt])
}

// メールテンプレート（プラン別の定型連絡文）
model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  planTier  String? // 対象プラン。nullなら全プラン共通
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 担当者（ログイン無しのため対応記録用に名前だけ管理）
model Staff {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}
