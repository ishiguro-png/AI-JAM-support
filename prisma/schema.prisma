generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 契約先（会社単位）。アカウント数・サポートプランはContractLineから都度集計する。
// statusはこのアプリ内だけで管理する対応ステータス（例: active/paused/cancelled）であり、
// torimatoのCSVが持つContractLine.contractStatus（契約中/契約前/解約）とは完全に別物。
// CSVインポートからstatusへ値を書き込むことはない。
model Contract {
  id           String   @id @default(cuid())
  companyName  String
  externalId   String?  @unique // torimato側の会社・顧客ID。CSVにあれば会社名より優先して同一会社の判定に使う
  contactName  String?
  contactEmail String?
  phone        String?
  status       String   @default("active") // active | cancelled | paused（アプリ内でのみ編集）
  notes        String?
  importedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  contractLines ContractLine[]
  supportLogs   SupportLog[]

  @@index([companyName])
}

// 契約明細（torimatoの1行 = 月契約 or 年契約などの単位）。
// 「最新のtorimato CSVが現在の契約状態の正」という方針のため、CSVインポートのたびに
// その会社のContractLineは全件削除してCSVの内容で作り直す（過去のCSVとの突合・
// upsertは行わない）。そのため契約IDが再エクスポートのたびに変わっても増殖しない。
// 会社単位のアカウント数は「contractStatus が 契約中 または 契約前」の行のquantityを
// 合算して算出する（解約・解約済み等は対象外。詳細はsrc/lib/contractLines.ts参照）。
// 契約開始日・終了日は無料期間や契約切り替えの都合で実態と一致しないことがあるため、
// 表示用データとしてのみ保持し、集計判定には一切使用しない。
model ContractLine {
  id              String    @id @default(cuid())
  contractId      String
  contract        Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractType    String // 例: "月契約" | "年契約"（torimatoのCSV表記をそのまま保持、表示用）
  contractStatus  String? // 例: "契約中" | "契約前" | "解約"（契約中・契約前がアカウント数集計の対象）
  quantity        Int
  startDate       DateTime? // 表示用のみ。集計には使用しない
  endDate         DateTime? // 表示用のみ。集計には使用しない
  productName     String? // 商品名/サービス名（表示用・検証用。CSVの表記をそのまま保持）
  amount          String? // 金額（表示用・検証用。書式（カンマ・通貨記号）を保持するため文字列で保存）
  applicationDate DateTime? // 申込日（表示用のみ。集計には使用しない）
  agencyName      String? // 代理店（表示用。CSVの表記をそのまま保持）
  billingMethod   String? // 請求方法（表示用。CSVの表記をそのまま保持）
  keyIssuedStatus String? // キー発行状況。"済" | "未" に正規化して保持（判定できない場合はCSVの値をそのまま保持）
  externalId      String?   @unique // torimato側の行の一意キー（表示用のみ。再インポート時の同一性判定には使用しない）
  importedAt      DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([contractId])
  @@index([contractStatus])
}

// 対応履歴（メール送信ログ含む、誰が・いつ・何を対応したか）
model SupportLog {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type        String // "email" | "call" | "visit" | "note" | "other"
  staffName   String
  subject     String?
  content     String
  emailTo     String?
  emailStatus String? // "sent" | "failed"（type=emailの場合のみ）
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([contractId])
  @@index([occurredAt])
}

// メールテンプレート（プラン別の定型連絡文）
model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  planTier  String? // 対象プラン。nullなら全プラン共通
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 担当者（ログイン無しのため対応記録用に名前だけ管理）
model Staff {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// CSVインポートの実行履歴。「最新CSVが現在の契約状態の正」という方針のもと、
// ContractLineは再インポートのたびに最新CSVの内容へ置き換えるため、過去の
// インポート内容そのもの（行単位の中身）はContractLineとしては残らない。
// 「いつ・どのファイルを・何件・何社・成功/エラー何件で取り込んだか」という
// 実行ログだけをここに残す。
model ImportBatch {
  id           String   @id @default(cuid())
  importedAt   DateTime @default(now())
  fileName     String?
  rowCount     Int
  companyCount Int
  successCount Int
  errorCount   Int
  createdAt    DateTime @default(now())
}
