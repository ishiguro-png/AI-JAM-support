generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 契約先（会社単位）。アカウント数・サポートプランはContractLineから都度集計する
model Contract {
  id           String    @id @default(cuid())
  companyName  String
  contactName  String?
  contactEmail String?
  phone        String?
  status       String    @default("active") // active | cancelled | paused
  notes        String?
  importedAt   DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  contractLines ContractLine[]
  supportLogs   SupportLog[]

  @@index([companyName])
}

// 契約明細（torimatoの1行 = 月契約 or 年契約などの単位）
// 会社単位のアカウント数は「contractStatus = 契約中」の行のquantityを合算して算出する。
// 契約開始日・終了日は無料期間や契約切り替えの都合で実態と一致しないことがあるため、
// 表示用データとしてのみ保持し、集計判定には一切使用しない。
model ContractLine {
  id             String   @id @default(cuid())
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractType   String // 例: "月契約" | "年契約"（torimatoのCSV表記をそのまま保持、表示用）
  contractStatus String? // 例: "契約中" | "契約前" | "解約"（アカウント数集計の判定に使用）
  quantity       Int
  startDate      DateTime? // 表示用のみ。集計には使用しない
  endDate        DateTime? // 表示用のみ。集計には使用しない
  externalId     String?  @unique // torimato側の行の一意キー（あれば再インポート時の重複防止に使う）
  importedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([contractId])
  @@index([contractStatus])
}

// 対応履歴（メール送信ログ含む、誰が・いつ・何を対応したか）
model SupportLog {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type        String // "email" | "call" | "visit" | "note" | "other"
  staffName   String
  subject     String?
  content     String
  emailTo     String?
  emailStatus String? // "sent" | "failed"（type=emailの場合のみ）
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([contractId])
  @@index([occurredAt])
}

// メールテンプレート（プラン別の定型連絡文）
model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  planTier  String? // 対象プラン。nullなら全プラン共通
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 担当者（ログイン無しのため対応記録用に名前だけ管理）
model Staff {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}
